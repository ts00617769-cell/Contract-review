# Optional. Without this key, 契約哨兵 uses the Taiwan freelancer rule library.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Paddle Billing. Required. Do not leave NEXT_PUBLIC_PADDLE_ENV empty.
# production = live account; sandbox = test account.
NEXT_PUBLIC_PADDLE_ENV=production
# Client-side token from Paddle → Developer Tools → Authentication → Client-side tokens.
# Live tokens start with live_ ; sandbox tokens start with test_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-only. Paddle → Authentication → API keys (pdl_live_apikey_... or pdl_sdbx_apikey_...).
PADDLE_API_KEY=

# Catalog price IDs (pri_...). Edit here or in lib/pricing-tiers.ts.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_01m132przkafxjxvmvy5kjrdg3
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=
# Optional alias used if PRO_MONTH is empty.
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_01m132przkafxjxvmvy5kjrdg3
