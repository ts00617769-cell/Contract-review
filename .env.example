# Optional. Without this key, 契約哨兵 uses the Taiwan freelancer rule library.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Paddle Billing. Required. Do not leave NEXT_PUBLIC_PADDLE_ENV empty.
# production = live account; sandbox = test account.
NEXT_PUBLIC_PADDLE_ENV=production
# Client-side token from Paddle → Developer Tools → Authentication → Client-side tokens.
# Live tokens start with live_ ; sandbox tokens start with test_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-only. Paddle → Authentication → API keys (pdl_live_apikey_... or pdl_sdbx_apikey_...).
PADDLE_API_KEY=
# The two settings below only apply to disabled/paddle-fulfillment, which is
# parked until a database exists. The live site does not read them.
# Paddle Webhook Secret (starts with ntfset_...)
PADDLE_WEBHOOK_SECRET=
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
# Server-only. Use a random value of at least 32 bytes to sign paid-access cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=

# One-time unlock ($2.99). 專業版 month / year subscriptions.
NEXT_PUBLIC_PADDLE_PRICE_ONETIME=pri_01m132przkafxjxvmvy5kjrdg3
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_01m13jzkdzx1pk3ycjtm2pc71x
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_01m13kbvkdypa63eprk8p8w97j
# Optional alias for the one-time price.
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_01m132przkafxjxvmvy5kjrdg3

# Public site settings.
NEXT_PUBLIC_SITE_URL=https://contract-review-five.vercel.app
# Required before launch so customers have a direct support/refund contact.
NEXT_PUBLIC_SUPPORT_EMAIL=
